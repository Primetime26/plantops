{
  "name": "@plantops/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/prepare-db.ts && prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@plantops/contracts": "*",
    "@prisma/client": "^6.19.3",
    "dotenv": "16.5.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.1",
    "@types/supertest": "6.0.3",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "tsx": "4.19.4",
    "vitest": "^5.1.0"
  }
}
