# Local only. npm run setup copies this to apps/api/.env, preserving existing files.
APP_MODE=local
# Relative to apps/api/prisma/schema.prisma. Do not use this as cloud persistence.
DATABASE_URL="file:./plantops.db"
PORT=3001
HOST=127.0.0.1
TRUST_LAYERO_PROXY=false
# Public Demo: use root layero.json. DATABASE_URL is unnecessary.
# npm run start:demo selects APP_MODE=demo without changing this file.
